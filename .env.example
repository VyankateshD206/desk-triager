# Empty = local SQLite. Paste a Neon connection string here, never in source control.
DATABASE_URL=
# Example: postgresql://USER:PASSWORD@ep-YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DESK_TOKEN=local-access-token
SIMULATOR_ENABLED=true
AI_PROVIDER=offline
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
TICK_GAP_SECONDS=8
# Optional local SQLite graph checkpoint file (also used with PostgreSQL incident storage).
GRAPH_CHECKPOINT_PATH=
# Optional read-only evidence sources; empty keeps the original local tools only.
LOKI_URL=
PROMETHEUS_URL=
DEMO_SERVICE_URL=

# Reviewed knowledge retrieval. Hash is a local lexical baseline; Gemini embeds via paid API.
RETRIEVAL_ENABLED=true
EMBEDDING_PROVIDER=hash

# Alternate adapter and optional second-pass causal critic.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
FALLBACK_PROVIDER=offline
CRITIC_ENABLED=false
CRITIC_PROVIDER=
# Optional OTLP HTTP collector; evidence text is excluded from span attributes.
OTEL_EXPORTER_OTLP_ENDPOINT=
